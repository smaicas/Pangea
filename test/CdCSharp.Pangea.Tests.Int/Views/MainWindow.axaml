<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CdCSharp.Pangea.Tests.Int.ViewModels"
        xmlns:theming="using:CdCSharp.Pangea.Theming.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
        x:Class="CdCSharp.Pangea.Tests.Int.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Pangea UI - Theme Showcase"
        Width="1400" Height="900">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="{DynamicResource ThemeControlLowBrush}"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="🎨" FontSize="24" VerticalAlignment="Center" />
                    <TextBlock Text="Pangea UI Theme Showcase"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="Theme:" VerticalAlignment="Center" />
                    <theming:ThemeSelector DataContext="{Binding ThemeSelector}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1" Padding="32">
            <StackPanel Spacing="32" MaxWidth="1200">

                <!-- Status Section -->
                <Border Background="{DynamicResource ThemeControlHighlightLowBrush}"
                        BorderBrush="{DynamicResource ThemeAccentBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Theme Status" 
                                   FontWeight="SemiBold" 
                                   FontSize="18" />
                        <TextBlock Text="{Binding StatusMessage}" 
                                   FontSize="14" />
                        <TextBlock Text="{Binding ProgressText}"
                                   FontSize="12"
                                   FontStyle="Italic" />
                        <Button Content="Update Status" 
                                Command="{Binding UpdateStatusCommand}"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- Test Section -->
                <Border Background="{DynamicResource ThemeControlHighlightLowBrush}"
                        BorderBrush="{DynamicResource ThemeAccentBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Command Tests" 
                                   FontWeight="SemiBold" 
                                   FontSize="18" />
                        <TextBlock Text="Test RelayCommand CanExecute automatic activation/deactivation"
                                   FontSize="14" />
                        <Button Content="🧪 Open Command Test Window"
                                Command="{Binding OpenCommandTestCommand}"
                                HorizontalAlignment="Left"
                                Padding="12,8" />
                    </StackPanel>
                </Border>

                <!-- Gallery Section -->
                <Border Background="{DynamicResource ThemeControlHighlightLowBrush}"
                        BorderBrush="{DynamicResource ThemeAccentBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Control Gallery"
                                   FontWeight="SemiBold"
                                   FontSize="18" />
                        <TextBlock Text="Every control the theme styles, on one screen, for visual review"
                                   FontSize="14" />
                        <Button Content="🧩 Open Control Gallery"
                                Command="{Binding OpenControlGalleryCommand}"
                                HorizontalAlignment="Left"
                                Padding="12,8" />
                    </StackPanel>
                </Border>

                <!-- Navigation Section -->
                <Border Background="{DynamicResource ThemeControlHighlightLowBrush}"
                        BorderBrush="{DynamicResource ThemeAccentBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Navigation"
                                   FontWeight="SemiBold"
                                   FontSize="18" />
                        <TextBlock Text="Typed requests, the back stack, and a screen that refuses to be left"
                                   FontSize="14" />
                        <Button Content="🧭 Open Navigation Demo"
                                Command="{Binding OpenNavigationDemoCommand}"
                                HorizontalAlignment="Left"
                                Padding="12,8" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>