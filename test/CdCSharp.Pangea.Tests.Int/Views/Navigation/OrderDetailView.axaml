<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CdCSharp.Pangea.Tests.Int.ViewModels.Navigation"
             x:Class="CdCSharp.Pangea.Tests.Int.Views.Navigation.OrderDetailView"
             x:DataType="vm:OrderDetailViewModel">
    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="📦 Order detail" FontSize="22" FontWeight="Bold" />
        <TextBlock Text="Arrived through a typed request. Nothing here was cast." Opacity="0.7" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Customer:" FontWeight="Bold" />
            <TextBlock Text="{Binding Customer}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Order id:" FontWeight="Bold" />
            <TextBlock Text="{Binding OrderId}" />
        </StackPanel>
        <TextBlock Text="{Binding Arrivals, StringFormat=Arrivals with a request: {0}}" Opacity="0.7" />
    </StackPanel>
</UserControl>
