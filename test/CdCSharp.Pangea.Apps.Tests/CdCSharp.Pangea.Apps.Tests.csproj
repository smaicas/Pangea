<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <IsPublishable>false</IsPublishable>
        <!-- xunit.v3 runs on Microsoft.Testing.Platform; the runner is selected in global.json -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\CdCSharp.Pangea.Apps\CdCSharp.Pangea.Apps.csproj" />
        <ProjectReference Include="..\..\src\CdCSharp.Pangea.Apps.Hosting\CdCSharp.Pangea.Apps.Hosting.csproj" />
        <ProjectReference Include="..\..\src\CdCSharp.Pangea.Testing\CdCSharp.Pangea.Testing.csproj" />
        <ProjectReference Include="..\..\src\CdCSharp.Pangea.Apps.Testing\CdCSharp.Pangea.Apps.Testing.csproj" />

        <!--
            Applied to this project as it is to an application, so the manifest test reads attributes
            the generator really wrote, and referenced as a library so the generator tests can drive it.
        -->
        <ProjectReference Include="..\..\src\CdCSharp.Pangea.Apps.CodeGeneration\CdCSharp.Pangea.Apps.CodeGeneration.csproj"
                          OutputItemType="Analyzer" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="CdCSharp.Pangea.Apps.PangeaAppAttribute">
            <_Parameter1>pangea-tests</_Parameter1>
            <_Parameter2>Pangea Tests</_Parameter2>
            <Description>The test assembly, described the way an application is.</Description>
        </AssemblyAttribute>
    </ItemGroup>
</Project>
