<Project Sdk="Microsoft.NET.Sdk">
    <!--
        Compiles the shipped templates against the toolkit in this working tree.

        The templates are the toolkit's worked examples, so they have to keep building as the API
        moves. There is nothing to run and nothing to assert: a template that no longer compiles
        fails the build, which is the whole point. The generator, the analyzer and the XAML
        compiler all run over this code, so a broken [Binding] field or a binding to a property
        that no longer exists is caught here.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <IsPublishable>false</IsPublishable>
        <EnableDefaultItems>false</EnableDefaultItems>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <!-- A library, so the two Program.Main methods below are ordinary methods. -->
        <OutputType>Library</OutputType>
        <!--
            Resource names are built from the root namespace and the linked path, so the shell
            template's strings end up under the name its ResourceManager asks for.
        -->
        <RootNamespace>PangeaShellApp</RootNamespace>
    </PropertyGroup>

    <PropertyGroup>
        <TemplateContent>$(MSBuildThisFileDirectory)..\..\templates\content\</TemplateContent>
    </PropertyGroup>

    <!--
        The platform heads are left out of both globs below. They compile against the Android and
        iOS SDKs, which this project has no reference to and no way to acquire without
        multi-targeting the whole of it; what they hold is a dozen lines of activity plumbing. The
        shared library every head starts is compiled, which is where the code worth checking lives.
    -->
    <PropertyGroup>
        <TemplateHeads>$(TemplateContent)**\*.Android\**;$(TemplateContent)**\*.iOS\**;$(TemplateContent)**\*.Browser\**</TemplateHeads>
        <TemplateOutput>$(TemplateContent)**\bin\**;$(TemplateContent)**\obj\**</TemplateOutput>
        <!--
            The templates' own test projects. They need a test framework this project does not
            reference, and compiling them here would only prove they compile: they are linked into
            CdCSharp.Pangea.Templates.Tests instead, which runs them.
        -->
        <TemplateTests>$(TemplateContent)**\*.Tests\**</TemplateTests>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="$(TemplateContent)**\*.cs"
                 Exclude="$(TemplateOutput);$(TemplateHeads);$(TemplateTests)"
                 Link="%(RecursiveDir)%(Filename)%(Extension)" />

        <AvaloniaXaml Include="$(TemplateContent)**\*.axaml"
                      Exclude="$(TemplateOutput);$(TemplateHeads);$(TemplateTests)"
                      Link="%(RecursiveDir)%(Filename)%(Extension)" />

        <!-- Linked flat under Resources\ so the neutral file and its translation land where
             PangeaShellApp.Resources.Strings expects them, satellite assembly included. -->
        <EmbeddedResource Include="$(TemplateContent)PangeaShellApp\PangeaShellApp\Resources\*.resx"
                          Link="Resources\%(Filename)%(Extension)" />

        <!-- What the shipped .targets does for a consumer of the package. A project reference
             brings no build assets, so the resource files are named here instead. -->
        <AdditionalFiles Include="$(TemplateContent)PangeaShellApp\PangeaShellApp\Resources\*.resx" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.1" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />

        <!--
            The data template's design-time factory is what `dotnet ef` looks for, so the type has to
            be available here too. Referenced plainly rather than with the development-dependency
            metadata the template uses: that form excludes the compile assets of the package and of
            everything under it, which is the whole of EF Core, and nothing here is published.
        -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\CdCSharp.Pangea\CdCSharp.Pangea.csproj" />
        <!-- What the Supabase template installs. -->
        <ProjectReference Include="..\..\src\CdCSharp.Pangea.Supabase\CdCSharp.Pangea.Supabase.csproj" />
        <!-- What the data template installs. It brings CdCSharp.Pangea.Data with it. -->
        <ProjectReference Include="..\..\src\CdCSharp.Pangea.Data.Sqlite\CdCSharp.Pangea.Data.Sqlite.csproj" />
        <ProjectReference Include="..\..\src\CdCSharp.Pangea.Binding.CodeGeneration\CdCSharp.Pangea.Binding.CodeGeneration.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\..\src\CdCSharp.Pangea.Localization.CodeAnalysis\CdCSharp.Pangea.Localization.CodeAnalysis.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
        <!-- The startup catalog, so the template's application starts the way a published one does -->
        <ProjectReference Include="..\..\src\CdCSharp.Pangea.CodeGeneration\CdCSharp.Pangea.CodeGeneration.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>
</Project>
