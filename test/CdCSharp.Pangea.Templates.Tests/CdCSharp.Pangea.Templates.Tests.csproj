<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <IsPublishable>false</IsPublishable>
        <!-- xunit.v3 runs on Microsoft.Testing.Platform; the runner is selected in global.json -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <!-- The template's application is a real Avalonia application, started headless -->
        <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.1" />
    </ItemGroup>

    <!--
        The tests the templates ship, run here.

        A test file in a template is a worked example, and an example that has not been run is a
        guess. Linked rather than referenced: the template's own project references the toolkit by
        package version, which does not exist yet for the code in this working tree, so the files
        are compiled against the sources instead - which is also the only way they would notice a
        toolkit change breaking them.
    -->
    <ItemGroup>
        <Compile Include="..\..\templates\content\**\*.Tests\**\*.cs"
                 Exclude="..\..\templates\content\**\bin\**;..\..\templates\content\**\obj\**"
                 Link="Templates\%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <!-- The templates' own sources, compiled against the toolkit in this working tree. -->
        <ProjectReference Include="..\CdCSharp.Pangea.Templates.Compile\CdCSharp.Pangea.Templates.Compile.csproj" />
        <!-- Used the way a generated project would use it, which is also how it is exercised. -->
        <ProjectReference Include="..\..\src\CdCSharp.Pangea.Testing\CdCSharp.Pangea.Testing.csproj" />
        <!-- The data template's screen is driven against a real database, as its own tests would. -->
        <ProjectReference Include="..\..\src\CdCSharp.Pangea.Data.Testing\CdCSharp.Pangea.Data.Testing.csproj" />
    </ItemGroup>
</Project>
