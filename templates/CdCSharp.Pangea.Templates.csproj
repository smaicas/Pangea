<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageType>Template</PackageType>
        <PackageId>CdCSharp.Pangea.Templates</PackageId>
        <Title>Pangea project templates</Title>
        <Description>dotnet new templates for Avalonia applications built on CdCSharp.Pangea.</Description>
        <PackageTags>$(PackageTags);template;dotnet-new;scaffolding</PackageTags>

        <TargetFramework>netstandard2.0</TargetFramework>
        <IncludeContentInPack>true</IncludeContentInPack>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <ContentTargetFolders>content</ContentTargetFolders>
        <EnableDefaultItems>false</EnableDefaultItems>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <!-- A template package ships no assemblies -->
        <NoWarn>$(NoWarn);NU5128</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="content\**\*" Exclude="content\**\bin\**;content\**\obj\**" />
        <Compile Remove="**\*" />
    </ItemGroup>

    <!--
        The skill is copied in rather than duplicated in source control, so the template hands out
        the same guidance the toolkit publishes.
    -->
    <Target Name="CopyAgentSkill" BeforeTargets="Build;Pack">
        <ItemGroup>
            <SkillFiles Include="$(MSBuildThisFileDirectory)..\tools\pangea-skill\**\*.md" />
        </ItemGroup>

        <Copy SourceFiles="@(SkillFiles)"
              DestinationFiles="@(SkillFiles->'$(MSBuildThisFileDirectory)content\MyPangeaApp\pangea-skill\%(RecursiveDir)%(Filename)%(Extension)')" />
    </Target>

    <!--
        Point the generated projects at the version being published. Matched by shape rather than by
        the literal current value, so re-packing at a different version stamps again: PangeaVersion
        is the only symbol whose default looks like a version number.
    -->
    <Target Name="StampPangeaVersion" BeforeTargets="GenerateNuspec;Pack" Condition="'$(Version)' != ''">
        <PropertyGroup>
            <TemplateConfig>$(MSBuildThisFileDirectory)content\MyPangeaApp\.template.config\template.json</TemplateConfig>
            <StampedConfig>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText($(TemplateConfig))), '&quot;defaultValue&quot;: &quot;\d+\.\d+\.\d+&quot;', '&quot;defaultValue&quot;: &quot;$(Version)&quot;'))</StampedConfig>
        </PropertyGroup>

        <WriteLinesToFile File="$(TemplateConfig)" Lines="$(StampedConfig)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    </Target>

    <!-- Leave the working tree as it was found: the stamp belongs in the package, not in source. -->
    <Target Name="RestorePangeaVersion" AfterTargets="Pack" Condition="'$(Version)' != ''">
        <PropertyGroup>
            <TemplateConfig>$(MSBuildThisFileDirectory)content\MyPangeaApp\.template.config\template.json</TemplateConfig>
            <RestoredConfig>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText($(TemplateConfig))), '&quot;defaultValue&quot;: &quot;\d+\.\d+\.\d+&quot;', '&quot;defaultValue&quot;: &quot;1.0.0&quot;'))</RestoredConfig>
        </PropertyGroup>

        <WriteLinesToFile File="$(TemplateConfig)" Lines="$(RestoredConfig)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    </Target>
</Project>
