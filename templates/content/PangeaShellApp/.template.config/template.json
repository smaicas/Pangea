{
  "$schema": "http://json.schemastore.org/template",
  "author": "CdCSharp",
  "classifications": [ "Avalonia", "Desktop", "MVVM", "Pangea" ],
  "identity": "CdCSharp.Pangea.Shell",
  "name": "Pangea Avalonia Shell App",
  "shortName": "pangea-shell",
  "sourceName": "PangeaShellApp",
  "defaultName": "PangeaShellApp",
  "preferNameDirectory": true,
  "description": "An Avalonia application wired to every Pangea feature: navigation with typed requests, localized strings, per-platform settings storage, a custom theme, validation and dialogs.",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "PangeaVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "1.0.0",
      "replaces": "PANGEA_VERSION",
      "description": "Version of the Pangea packages to reference."
    },
    "IncludeSkill": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Copy the Pangea agent skill into the project so AI coding agents can read it."
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!IncludeSkill)",
          "exclude": [ ".claude/**" ]
        }
      ]
    }
  ],
  "primaryOutputs": [ { "path": "PangeaShellApp/PangeaShellApp.csproj" } ],
  "postActions": [
    {
      "description": "Restore NuGet packages",
      "manualInstructions": [ { "text": "Run 'dotnet restore'" } ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}
