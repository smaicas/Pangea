<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <IsPublishable>false</IsPublishable>
        <!-- xunit.v3 runs on Microsoft.Testing.Platform; the runner is selected in global.json. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" Version="3.2.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PangeaSupabaseApp\PangeaSupabaseApp.csproj" />
        <!--
            The container a view model needs, with test doubles in it - including the in-memory
            storage the cache is written to, so a test never touches a disk. No Avalonia is started:
            these tests are about what a screen decides.
        -->
        <PackageReference Include="CdCSharp.Pangea.Testing" Version="$(PangeaVersion)" />
    </ItemGroup>
</Project>
