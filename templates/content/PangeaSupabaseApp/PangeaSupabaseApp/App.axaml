<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="using:PangeaSupabaseApp.Themes"
             x:Class="PangeaSupabaseApp.App">

    <!-- PangeaUI is added to Application.Styles by the theming feature at startup; these sit on
         top of it. Colour is only ever a DynamicResource, so the palette - and the light/dark
         variant - stays the single place appearance is decided.

         Sizes are not here either: they come from ThemeMetrics.Touch, handed to the theme in
         App.axaml.cs. A height written into a style is a height that only reaches the controls
         somebody remembered to style. -->
    <Application.Styles>

        <!-- The components - what a card and a primary button are - in a file of their own, so
             neither this one nor that one is the file nobody reads to the end. Added as a type:
             see Components.axaml.cs for why that beats an avares:// URI. -->
        <themes:Components />

        <!-- The type scale. Every loose FontSize in a view is a decision nobody made on purpose,
             and on a phone they add up to a screen with no hierarchy at all. -->

        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundHighBrush}" />
        </Style>

        <Style Selector="TextBlock.subtitle">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundLowBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

    </Application.Styles>
</Application>
