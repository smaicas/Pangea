<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <AssemblyName>PangeaOmniApp</AssemblyName>
        <RootNamespace>PangeaOmniApp</RootNamespace>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    </PropertyGroup>

    <!--
        The manifest. The host reads it from the built assembly without running it: the id is how
        it finds the application, names its single-instance lock and prefixes its messages, so it
        never changes once the application is in use.
    -->
    <PropertyGroup>
        <PangeaAppId>pangeaomniapp</PangeaAppId>
        <PangeaAppName>PangeaOmniApp</PangeaAppName>
        <PangeaAppDescription>An application of the Omni workspace.</PangeaAppDescription>
        <PangeaAppIcon>Assets\icon.png</PangeaAppIcon>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Fonts.Inter" />
        <PackageReference Include="CdCSharp.Pangea" />
        <!-- The manifest, the bus, one copy at a time and the host's theme. -->
        <PackageReference Include="CdCSharp.Pangea.Apps" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PangeaOmniApp.Protocol\PangeaOmniApp.Protocol.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="PangeaOmniApp.Tests" />
    </ItemGroup>
</Project>
