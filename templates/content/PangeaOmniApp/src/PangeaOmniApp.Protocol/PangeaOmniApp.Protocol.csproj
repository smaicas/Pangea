<Project Sdk="Microsoft.NET.Sdk">
    <!--
        What other applications can ask this one. Published as a package - to the workspace feed with
        `dotnet pack -o ../../feed` - so an application that wants to talk to this one references the
        records and nothing else: no Avalonia, no application code.

        The records are the contract. Add optional members freely; renaming a member, or the id in an
        [AppMessage], breaks every application built against the old one.
    -->
    <PropertyGroup>
        <PackageId>PangeaOmniApp.Protocol</PackageId>
        <!-- Change it when the records change: NuGet caches a version forever, so repacking one is invisible. -->
        <Version>1.0.0</Version>
        <Description>Requests PangeaOmniApp answers on the Omni bus.</Description>
        <IsPackable>true</IsPackable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- Only the members that need saying are documented; the rest are what their names say. -->
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CdCSharp.Pangea.Apps.Abstractions" />
    </ItemGroup>
</Project>
