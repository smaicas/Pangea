<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <!--
        The manifest. The host reads it from the built assembly without running it: the id is how
        it finds the application, names its single-instance lock and prefixes its messages, so it
        never changes once the application is in use.
    -->
    <PropertyGroup>
        <PangeaAppId>pangeaomniapp</PangeaAppId>
        <PangeaAppName>PangeaOmniApp</PangeaAppName>
        <PangeaAppDescription>An application of the Omni workspace.</PangeaAppDescription>
        <PangeaAppIcon>Assets\icon.png</PangeaAppIcon>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.1" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
        <PackageReference Include="CdCSharp.Pangea" Version="PANGEA_VERSION" />
        <!-- The manifest, the bus, one copy at a time and the host's theme. -->
        <PackageReference Include="CdCSharp.Pangea.Apps" Version="PANGEA_VERSION" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PangeaOmniApp.Protocol\PangeaOmniApp.Protocol.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="PangeaOmniApp.Tests" />
    </ItemGroup>
</Project>
