<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <!--
            The Omni workspace feed, where the applications of the workspace publish their protocol
            packages for each other. Relative to this file: the repository lives in apps/<name>.
        -->
        <add key="omni" value="../../feed" />
    </packageSources>

    <packageSourceMapping>
        <packageSource key="omni">
            <package pattern="*.Protocol" />
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
