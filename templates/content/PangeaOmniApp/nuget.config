<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <!--
            The Omni workspace feed: the protocol packages the applications of the workspace publish
            for each other, and previews of Pangea when the workspace packs them. Relative to this
            file: the repository lives in apps/<name>.
        -->
        <add key="omni" value="../../feed" />
    </packageSources>

    <packageSourceMapping>
        <packageSource key="omni">
            <package pattern="CdCSharp.Pangea*" />
            <package pattern="*.Protocol" />
        </packageSource>
        <packageSource key="nuget.org">
            <!-- Pangea releases; previews come from the feed above. -->
            <package pattern="CdCSharp.Pangea*" />
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
