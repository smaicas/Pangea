<Project>
  <PropertyGroup>
    <Authors>CdCSharp</Authors>
    <Company>CdCSharp</Company>
    <Copyright>Copyright © 2025 CdCSharp</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/smaicas/CdCSharp.Pangea</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/smaicas/CdCSharp.Pangea</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Ship the XML docs so consumers - and the tools they use - get the API documentation
       that is already written in the source. CS1591 stays off: not every public member needs
       a comment to be obvious. -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    The repository builds clean or it does not build. A nullability warning is a contract stated
    and not kept, a broken cref ships inside the XML documentation, and an obsolete API is the
    next upgrade's breakage. Raising the bar is only worth it while the count is zero.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <PropertyGroup>
    <PackageTags>avalonia;mvvm;toolkit</PackageTags>
  </PropertyGroup>
</Project>