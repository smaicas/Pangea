<Project>
  <PropertyGroup>
    <Authors>CdCSharp</Authors>
    <Company>CdCSharp</Company>
    <Copyright>Copyright © 2025 CdCSharp</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/smaicas/CdCSharp.Pangea</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/smaicas/CdCSharp.Pangea</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Ship the XML docs so consumers - and the tools they use - get the API documentation
       that is already written in the source. CS1591 stays off: not every public member needs
       a comment to be obvious. -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="" Visible="false" />

    <!--
      The agent skill, carried by the main package only: shipping it in every feature package
      would put five copies of the same guidance on disk.
    -->
    <None Include="$(MSBuildThisFileDirectory)tools\pangea-skill\**\*.md"
          Pack="true"
          PackagePath="tools\pangea-skill\%(RecursiveDir)%(Filename)%(Extension)"
          Visible="false"
          Condition="'$(PackageId)' == 'CdCSharp.Pangea'" />
  </ItemGroup>

  <PropertyGroup>
    <PackageTags>avalonia;mvvm;toolkit</PackageTags>
  </PropertyGroup>
</Project>