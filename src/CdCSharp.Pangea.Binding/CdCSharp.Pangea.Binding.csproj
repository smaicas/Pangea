<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>12.0</LangVersion>

        <!-- Package Metadata -->
        <PackageId>CdCSharp.Pangea.Binding</PackageId>
        <Description>Binding feature for CdCSharp.Pangea - Auto-generates properties from fields with [Binding] attribute</Description>
        <PackageTags>$(PackageTags);binding;mvvm;properties</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\CdCSharp.Pangea.Core\CdCSharp.Pangea.Core.csproj" />
    </ItemGroup>

</Project>