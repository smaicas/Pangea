<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IncludeAnalyzerReferences>true</IncludeAnalyzerReferences>
		<LangVersion>12.0</LangVersion>

		<!-- Package Metadata -->
		<PackageId>CdCSharp.Pangea</PackageId>
		<Description>Modern Avalonia ToolKit with MVVM, Binding, Theming and Storage features</Description>
		<PackageTags>$(PackageTags);source-generator;binding;theming;storage</PackageTags>

		<DevelopmentDependency>false</DevelopmentDependency>
		<IncludeBuildOutput>true</IncludeBuildOutput>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.1" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />

		<!-- DPAPI, for the secret store. Windows-only at runtime and guarded by a platform check;
		     the package itself loads everywhere, so nothing about referencing it is conditional. -->
		<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
	</ItemGroup>

	<ItemGroup>
		<!-- Startup composition is internal; the tests drive it without it becoming public API. -->
		<InternalsVisibleTo Include="CdCSharp.Pangea.Tests" />
	</ItemGroup>

	<!--
		PrivateAssets="none" on every feature, because this is the package people install and the
		generators live in the ones underneath it. The default would pack these as
		exclude="Build,Analyzers", which says the opposite of what the toolkit needs: no [Binding]
		properties, no startup catalog, no resource key checking in the application that installs it.
	-->
	<ItemGroup>
		<ProjectReference Include="..\CdCSharp.Pangea.CodeGeneration\CdCSharp.Pangea.CodeGeneration.csproj"
		                  OutputItemType="Analyzer"
		                  ReferenceOutputAssembly="false"
		                  PrivateAssets="all" />
		<ProjectReference Include="..\CdCSharp.Pangea.Core\CdCSharp.Pangea.Core.csproj" PrivateAssets="none" />
		<ProjectReference Include="..\CdCSharp.Pangea.Binding\CdCSharp.Pangea.Binding.csproj" PrivateAssets="none" />
		<ProjectReference Include="..\CdCSharp.Pangea.Storage\CdCSharp.Pangea.Storage.csproj" PrivateAssets="none" />
		<ProjectReference Include="..\CdCSharp.Pangea.Theming\CdCSharp.Pangea.Theming.csproj" PrivateAssets="none" />
		<ProjectReference Include="..\CdCSharp.Pangea.Localization\CdCSharp.Pangea.Localization.csproj" PrivateAssets="none" />
		<ProjectReference Include="..\CdCSharp.Pangea.Navigation\CdCSharp.Pangea.Navigation.csproj" PrivateAssets="none" />
	</ItemGroup>


</Project>