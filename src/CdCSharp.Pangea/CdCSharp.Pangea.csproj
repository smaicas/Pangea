<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IncludeAnalyzerReferences>true</IncludeAnalyzerReferences>
		<LangVersion>12.0</LangVersion>

		<!-- Package Metadata -->
		<PackageId>CdCSharp.Pangea</PackageId>
		<Description>Modern Avalonia ToolKit with MVVM, Binding, Theming and Storage features</Description>
		<PackageTags>$(PackageTags);source-generator;binding;theming;storage</PackageTags>

		<DevelopmentDependency>false</DevelopmentDependency>
		<IncludeBuildOutput>true</IncludeBuildOutput>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.1" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CdCSharp.Pangea.Core\CdCSharp.Pangea.Core.csproj" />
		<ProjectReference Include="..\CdCSharp.Pangea.Binding\CdCSharp.Pangea.Binding.csproj" />
		<ProjectReference Include="..\CdCSharp.Pangea.Storage\CdCSharp.Pangea.Storage.csproj" />
		<ProjectReference Include="..\CdCSharp.Pangea.Theming\CdCSharp.Pangea.Theming.csproj" />
		<ProjectReference Include="..\CdCSharp.Pangea.Localization\CdCSharp.Pangea.Localization.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Binding CodeGeneration Analyzer -->
		<None Include="..\CdCSharp.Pangea.Binding.CodeGeneration\bin\$(Configuration)\netstandard2.0\CdCSharp.Pangea.Binding.CodeGeneration.dll" Pack="true" PackagePath="analyzers\dotnet\cs\CdCSharp.Pangea.Binding.CodeGeneration.dll" Visible="false" />

		<!-- Incluir PDBs para debugging si existen -->
		<None Include="..\CdCSharp.Pangea.Binding.CodeGeneration\bin\$(Configuration)\netstandard2.0\CdCSharp.Pangea.Binding.CodeGeneration.pdb" Pack="true" PackagePath="analyzers\dotnet\cs\CdCSharp.Pangea.Binding.CodeGeneration.pdb" Visible="false" Condition="Exists('..\CdCSharp.Pangea.Binding.CodeGeneration\bin\$(Configuration)\netstandard2.0\CdCSharp.Pangea.Binding.CodeGeneration.pdb')" />
	</ItemGroup>

	<Target Name="EnsureAnalyzersExistBeforePack" BeforeTargets="GenerateNuspec;Pack">
		<Error Text="❌ Binding analyzer not found: ..\CdCSharp.Pangea.Binding.CodeGeneration\bin\$(Configuration)\netstandard2.0\CdCSharp.Pangea.Binding.CodeGeneration.dll&#xA;Build CdCSharp.Pangea.Binding.CodeGeneration first." Condition="!Exists('..\CdCSharp.Pangea.Binding.CodeGeneration\bin\$(Configuration)\netstandard2.0\CdCSharp.Pangea.Binding.CodeGeneration.dll')" />

		<Message Text="✅ Binding analyzer found and ready for packaging:" Importance="high" />
		<Message Text="  → CdCSharp.Pangea.Binding.CodeGeneration.dll" Importance="high" />
	</Target>
</Project>