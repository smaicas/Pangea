<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>12.0</LangVersion>

        <!-- Package Metadata -->
        <PackageId>CdCSharp.Pangea.Apps.Hosting</PackageId>
        <Description>The host's side of Pangea applications: a broker that routes requests and events between connected applications, starts the one a request needs, and pushes a shared environment to all of them; and a reader for an application's manifest that never runs its code.</Description>
        <PackageTags>$(PackageTags);apps;messaging;ipc;host;shell;broker</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="CdCSharp.Pangea.Apps.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CdCSharp.Pangea.Apps.Abstractions\CdCSharp.Pangea.Apps.Abstractions.csproj" PrivateAssets="none" />
    </ItemGroup>
</Project>
