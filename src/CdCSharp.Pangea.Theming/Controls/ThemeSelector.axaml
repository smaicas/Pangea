<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:CdCSharp.Pangea.Theming.Controls"
    x:Class="CdCSharp.Pangea.Theming.Controls.ThemeSelector"
    x:DataType="controls:ThemeSelectorViewModel">

    <ToggleButton
        IsChecked="{Binding IsDarkSelected, Mode=TwoWay}"
        HorizontalAlignment="Left"
        ToolTip.Tip="{Binding ThemeTooltip}"
        Width="44"
        Height="44"
        CornerRadius="22"
        Padding="0">

        <Border CornerRadius="20"
                Width="36"
                Height="36">
            <TextBlock Text="{Binding ThemeIcon}"
                       FontSize="20"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>
    </ToggleButton>

</UserControl>