<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>12.0</LangVersion>

        <!-- Package Metadata -->
        <PackageId>CdCSharp.Pangea.Theming</PackageId>
        <Description>Theming feature for CdCSharp.Pangea - Dynamic theme switching with Simple UI</Description>
        <PackageTags>avalonia;theming;themes;ui;simple-ui</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\CdCSharp.Pangea.Core\CdCSharp.Pangea.Core.csproj" PrivateAssets="none" />
        <ProjectReference Include="..\CdCSharp.Pangea.CodeGeneration\CdCSharp.Pangea.CodeGeneration.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.1" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaXaml Remove="Resources\Themes\InvariantResources.axaml" />
        <AvaloniaResource Include="Resources\Themes\InvariantResources.axaml" />
        <AvaloniaXaml Remove="Resources\Themes\Root.axaml" />
        <AvaloniaResource Include="Resources\Themes\Root.axaml" />
        <!-- Simple theme control dictionaries, rebased on Avalonia 12.1.1 -->
        <None Remove="Resources\Controls\Shared\*.xaml" />
        <AvaloniaResource Include="Resources\Controls\Shared\*.xaml" />
    </ItemGroup>

</Project>