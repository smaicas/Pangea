<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>12.0</LangVersion>

        <!-- Package Metadata -->
        <PackageId>CdCSharp.Pangea.Theming</PackageId>
        <Description>Theming feature for CdCSharp.Pangea - Dynamic theme switching with Simple UI</Description>
        <PackageTags>avalonia;theming;themes;ui;simple-ui</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <!-- Generator reference as analyzer -->
        <ProjectReference Include="..\CdCSharp.Pangea.Binding\CdCSharp.Pangea.Binding.csproj" />
        <ProjectReference Include="..\CdCSharp.Pangea.Binding.CodeGeneration\CdCSharp.Pangea.Binding.CodeGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
      <ProjectReference Include="..\CdCSharp.Pangea.Storage\CdCSharp.Pangea.Storage.csproj" />
        <ProjectReference Include="..\CdCSharp.Pangea.Core\CdCSharp.Pangea.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.1" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaXaml Remove="Resources\Themes\InvariantResources.axaml" />
        <AvaloniaResource Include="Resources\Themes\InvariantResources.axaml" />
        <AvaloniaXaml Remove="Resources\Themes\Root.axaml" />
        <AvaloniaResource Include="Resources\Themes\Root.axaml" />
        <!-- Simple theme control dictionaries, rebased on Avalonia 12.1.1 -->
        <None Remove="Resources\Controls\Shared\*.xaml" />
        <AvaloniaResource Include="Resources\Controls\Shared\*.xaml" />
    </ItemGroup>

</Project>