<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <LangVersion>10</LangVersion>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Package Metadata -->
        <PackageId>CdCSharp.Pangea.Data.CodeAnalysis</PackageId>
        <Description>Analyzers for CdCSharp.Pangea.Data - Internal use</Description>
        <PackageTags>$(PackageTags);database;analyzer;internal</PackageTags>
        <DevelopmentDependency>true</DevelopmentDependency>
        <NoPackageAnalysis>true</NoPackageAnalysis>

        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

        <DebugType>portable</DebugType>
        <DebugSymbols>true</DebugSymbols>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.6.0" PrivateAssets="all" />
    </ItemGroup>

    <Target Name="VerifyAnalyzerBuild" AfterTargets="Build">
        <Message Text="✅ Data analyzer built successfully: $(OutputPath)$(AssemblyName).dll" Condition="Exists('$(OutputPath)$(AssemblyName).dll')" Importance="high" />
        <Error Text="❌ Data analyzer build failed: $(OutputPath)$(AssemblyName).dll" Condition="!Exists('$(OutputPath)$(AssemblyName).dll')" />
    </Target>

    <ItemGroup>
        <!-- Roslyn requires a declared release history for any analyzer that ships rules. -->
        <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
        <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    </ItemGroup>
</Project>
